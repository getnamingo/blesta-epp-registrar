<?php /** @var View $this */ ?>
<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([[ 
    'name' => $this->_('Epp.add_module_row', true),
    'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . ($module->id ?? '')]
]]);
$this->Widget->setBodyWrapper(false);
$this->Widget->create(
    $this->_('AdminCompanyModules.manage.boxtitle_manage', true, $this->Html->safe($module->name ?? 'EPP Registrar')),
    ['id' => 'manage_epp']
);
$rows = (array) ($module->rows ?? []);
if ($rows) {
?>
<table class="table">
    <thead><tr>
        <th><?php $this->_('Epp.manage.host'); ?></th>
        <th><?php $this->_('Epp.manage.client_id'); ?></th>
        <th><?php $this->_('Epp.manage.profile'); ?></th>
        <th><?php $this->_('Epp.manage.tlds'); ?></th>
        <th class="text-end"><?php $this->_('Epp.manage.options'); ?></th>
    </tr></thead>
    <tbody>
    <?php foreach ($rows as $row) { ?>
        <tr>
            <td><?php echo $this->Html->safe(($row->meta->account_name ?? '') ?: (($row->meta->host ?? '') . ':' . ($row->meta->port ?? '700'))); ?></td>
            <td><?php echo $this->Html->safe($row->meta->clid ?? ''); ?></td>
            <td><?php echo $this->Html->safe($row->meta->registry_profile ?? 'generic'); ?></td>
            <td><?php echo $this->Html->safe($row->meta->tlds ?? ''); ?></td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" href="<?php echo $this->Html->safe(
                    $this->base_uri . 'settings/company/modules/editrow/' . ($module->id ?? '') . '/' . ($row->id ?? '') . '/'
                ); ?>" title="<?php $this->_('Epp.manage.edit'); ?>"><i class="bi bi-pencil"></i></a>
                <?php
                $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                $this->Form->fieldHidden('id', $module->id ?? '');
                $this->Form->fieldHidden('row_id', $row->id ?? '');
                ?>
                <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                    data-confirm-message="<?php echo $this->Html->safe($this->_('Epp.manage.confirm_delete', true)); ?>"
                    title="<?php $this->_('Epp.manage.delete'); ?>"><i class="bi bi-trash"></i></button>
                <?php $this->Form->end(); ?>
            </td>
        </tr>
    <?php } ?>
    </tbody>
</table>
<?php } else { ?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-inbox" style="font-size:3rem;opacity:.3"></i>
    <p class="mt-3 mb-0"><?php $this->_('Epp.manage.no_rows'); ?></p>
</div>
<?php }
$this->Widget->end();
?>
